{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "outDir": "dist-worker",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/composition/worker.ts",
    "src/composition/worker-process.ts",
    "src/modules/jobs/**/*.ts",
    "src/modules/accounts/domain/**/*.ts",
    "src/modules/accounts/application/accounts-service.ts",
    "src/modules/accounts/application/mailbox-discovery-scheduler.ts",
    "src/modules/accounts/infrastructure/imap-smtp-mail-provider.ts",
    "src/modules/mail/**/*.ts",
    "src/shared/application/secret-encryption.ts",
    "src/shared/infrastructure/crypto/**/*.ts",
    "src/shared/infrastructure/config/**/*.ts",
    "src/shared/infrastructure/logging/**/*.ts",
    "src/shared/infrastructure/database/database-worker.ts",
    "src/shared/infrastructure/database/schema.ts",
    "src/shared/infrastructure/database/migrate.ts"
  ]
}
