# Minimal production deployment configuration.
# Maildock's base Docker Compose file supplies stable runtime defaults internally.

# Exact canonical browser origin. Production requires HTTPS and no path/query/fragment.
APP_ORIGIN=https://maildock.example.com

# Bundled PostgreSQL password.
POSTGRES_PASSWORD=

# Generate each secret independently; never reuse or commit real values.
# AUTH_SECRET: at least 32 random bytes, base64 encoded.
AUTH_SECRET=
# The temporary setup secret is generated in the app container logs.
# Active AES-256-GCM key: exactly 32 random bytes, base64 encoded.
CREDENTIALS_ENCRYPTION_KEY=
