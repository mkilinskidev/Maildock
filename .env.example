# Maildock security mode. Use production behind HTTPS; the development Compose override changes this.
MAILDOCK_ENV=production

# Exact canonical browser origin. Production requires HTTPS and no path/query/fragment.
APP_ORIGIN=https://maildock.example.com

# Used by direct local commands. Compose builds its internal URL from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://maildock:change-me@127.0.0.1:5432/maildock
POSTGRES_PASSWORD=

# Generate independently; never reuse or commit real values.
# AUTH_SECRET: at least 32 random bytes, base64 encoded.
# CREDENTIALS_ENCRYPTION_KEY: exactly 32 random bytes, base64 encoded.
AUTH_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
# Identifies the active credential key. Use v1 initially.
CREDENTIALS_ENCRYPTION_KEY_ID=v1
# JSON object of prior key IDs to base64 keys, retained only during rotation.
CREDENTIALS_ENCRYPTION_PREVIOUS_KEYS={}

# Microsoft Entra app registration (Web redirect URI: APP_ORIGIN/api/oauth/microsoft/callback).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Absolute path. Compose overrides this with its persistent attachment volume path.
ATTACHMENTS_PATH=/var/lib/maildock/attachments

LOG_LEVEL=info
DATABASE_POOL_SIZE=10
WORKER_CONCURRENCY=5
# IMAP SINCE is day-granular, so the cutoff calendar day is intentionally included.
MAILDOCK_INITIAL_SYNC_DAYS=30
MAILDOCK_MESSAGE_FETCH_BATCH_SIZE=150
MAILDOCK_BACKFILL_CHUNK_SIZE=500
MAILDOCK_MESSAGE_SYNC_CONCURRENCY=2
MAILDOCK_MAIL_POLL_INTERVAL_SECONDS=300
# Reader readiness checks (not mailbox synchronization), 100–2500 ms.
# Doubles every 5 seconds of waiting, capped at 2500 ms.
MAILDOCK_CONTENT_POLL_INTERVAL_MS=400
MAILDOCK_MAX_MESSAGE_TEXT_PART_BYTES=5242880

# Bytes; MIME limit includes base64 encoding and headers.
MAILDOCK_MAX_ATTACHMENT_BYTES=15728640
MAILDOCK_MAX_OUTGOING_ATTACHMENT_BYTES=18874368
MAILDOCK_MAX_OUTGOING_MIME_BYTES=26214400
